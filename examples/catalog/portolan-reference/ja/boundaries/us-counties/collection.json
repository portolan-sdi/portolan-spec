  "table:columns": [
    {
      "name": "fid",
      "type": "bigint"
    },
    {
      "name": "STATEFP",
      "type": "varchar",
      "description": "州または領域の2桁FIPSコードです。先頭ゼロを保持した文字列です。"
    },
    {
      "name": "COUNTYFP",
      "type": "varchar",
      "description": "3桁の郡FIPSコードです。州内で一意です。"
    },
    {
      "name": "COUNTYNS",
      "type": "varchar",
      "description": "8桁のANSI（GNIS）コードです。FIPS再割当て後も変わらない恒久識別子です。"
    },
    {
      "name": "GEOIDFQ",
      "type": "varchar",
      "description": "完全修飾GEOIDです。0500000USとGEOIDを連結します。data.census.govのGEO_ID列と直接一致します。2023年より前はAFFGEOIDと呼ばれました。"
    },
    {
      "name": "GEOID",
      "type": "varchar",
      "description": "STATEFPとCOUNTYFPを連結した5桁コードで、米国郡統計の標準結合キーです。整数にすると先頭ゼロが消えるため、文字列のまま使います。"
    },
    {
      "name": "NAME",
      "type": "varchar",
      "description": "基本名のみです。例: Denver。Washingtonという行が31件あるため、キーには使えません。"
    },
    {
      "name": "NAMELSAD",
      "type": "varchar",
      "description": "法的または統計的な説明を含む名称です。例: St. Louis city。表示名として使います。"
    },
    {
      "name": "STUSPS",
      "type": "varchar",
      "description": "州または領域の2文字USPS略称です。"
    },
    {
      "name": "STATE_NAME",
      "type": "varchar",
      "description": "州または領域の正式名称です。"
    },
    {
      "name": "LSAD",
      "type": "varchar",
      "description": "法的または統計的地域説明コードです。このファイルには12種類の郡相当区分があります。"
    },
    {
      "name": "ALAND",
      "type": "bigint",
      "description": "陸地面積（平方メートル）です。この簡略化形状ではなく、完全解像度の法定境界から算出しています。"
    },
    {
      "name": "AWATER",
      "type": "bigint",
      "description": "水域面積（平方メートル）です。切り取った海岸線形状の外側にある領海も含みます。"
    },
    {
      "name": "geom",
      "type": "geometry('epsg:4269')",
      "description": "海岸線で切り取った郡の形状です。NAD83の経度・緯度を使います。"
    },
    {
      "name": "bbox",
      "type": "struct(xmin double, ymin double, xmax double, ymax double)",
      "description": "地物ごとのバウンディングボックス構造体で、GeoParquet coveringです。"
    }
  ],
