      "roles": [
        "processor"
      ]
    },
    {
      "name": "Portolan SDI",
      "url": "https://github.com/portolan-sdi",
      "email": "portolan@googlegroups.com",
      "roles": [
        "host"
      ]
    }
  ],
  "extent": {
    "spatial": {
      "bbox": [
        [
          -122.51042,
          37.708191,
