          "#f28e2b",
          "Europe",
          "#59a14f",
          "North America",
          "#e15759",
          "South America",
          "#b07aa1",
          "Oceania",
          "#76b7b2",
          "Antarctica",
          "#edc948",
          "Seven seas (open ocean)",
